{
  "name": "@mirva/sdk",
  "version": "0.1.0",
  "description": "Client for Mirva: call the tools your account has on its boards and canvases, over one WebSocket.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "mirva",
    "sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepkit/bson": "^1.0.19",
    "@deepkit/core": "^1.0.19",
    "@deepkit/core-rxjs": "^1.0.19",
    "@deepkit/event": "^1.0.19",
    "@deepkit/injector": "^1.0.19",
    "@deepkit/logger": "^1.0.19",
    "@deepkit/rpc": "^1.0.19",
    "@deepkit/type": "^1.0.19",
    "rxjs": "^7.5.6",
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirva-ai/mirva-mcp.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/mirva-ai/mirva-mcp/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/mirva-ai/mirva-mcp/issues"
  }
}
