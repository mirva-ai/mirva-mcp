{
  "name": "mirva-js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "packages/mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @mirva/sdk && npm run build -w @mirva/mcp",
    "check": "tsc -p tsconfig.json",
    "test": "node test/board-geometry.ts && node test/session.ts",
    "start": "node --conditions=source packages/mcp/src/index.ts",
    "viewer": "node --conditions=source packages/mcp/src/viewer/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
